# Copy this file to .env and fill in your own values.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Supabase: Project Settings > Database > Connection string > URI (Session pooler)
# Leave empty to use the local db.sqlite3 instead.
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Gmail SMTP (use a Google App Password, not your real password)
EMAIL_HOST_USER=your.email@ue.edu.ph
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Barangay 10 <your.email@ue.edu.ph>
